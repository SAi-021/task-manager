# ---- Database ----
# Option A: a single connection URL (what most free MySQL hosts give you).
# Example: mysql://user:pass@host:3306/dbname
DATABASE_URL=

# Option B: individual parts (used only if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taskmanager

# ---- Auth ----
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- CORS ----
# Comma-separated list of allowed frontend origins, or * for all.
# Example: https://your-frontend.vercel.app
CORS_ORIGINS=*
